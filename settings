<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pengaturan Akun • The Last Call Film</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700&display=swap" rel="stylesheet">
    
    <!-- FIREBASE SDK -->
    <script src="https://www.gstatic.com/firebasejs/10.4.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.4.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.4.0/firebase-firestore-compat.js"></script>

    <style>
        :root { --bg-dark: #12110f; --border: rgba(255,255,255,0.1); --accent: #6ee7b7; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
        body { background: var(--bg-dark); color: #fff; min-height: 100vh; padding: 20px; display: flex; justify-content: center; align-items: center; }
        .card { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 16px; padding: 30px; width: 100%; max-width: 450px; }
        h2 { font-family: 'Playfair Display', serif; font-size: 1.8rem; margin-bottom: 8px; }
        p.sub { font-size: 0.85rem; color: #aaa; margin-bottom: 25px; }
        
        .form-group { margin-bottom: 18px; }
        label { display: block; font-size: 0.8rem; color: #ccc; margin-bottom: 6px; }
        input { width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 8px; color: #fff; outline: none; font-size: 0.9rem; }
        input:disabled { background: rgba(255,255,255,0.02); color: #666; cursor: not-allowed; }
        
        .btn-save { width: 100%; padding: 12px; background: var(--accent); color: #000; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; margin-top: 10px; }
        .btn-back { display: block; text-align: center; color: #aaa; font-size: 0.85rem; text-decoration: none; margin-top: 15px; }
        .btn-back:hover { color: #fff; }
    </style>
</head>
<body>

    <div class="card">
        <h2>Profil Akun</h2>
        <p class="sub">Kelola informasi diri Anda untuk pemulihan akun jika terkendala.</p>

        <form id="profileForm" onsubmit="simpanProfil(event)">
            <div class="form-group">
                <label>Email Terdaftar (Login)</label>
                <input type="email" id="pEmail" disabled placeholder="Memuat email...">
            </div>

            <div class="form-group">
                <label>Nama Lengkap</label>
                <input type="text" id="pNama" placeholder="Contoh: Budi Santoso" required>
            </div>

            <div class="form-group">
                <label>Nomor HP / WhatsApp</label>
                <input type="tel" id="pNoHp" placeholder="081234567890" required>
            </div>

            <div class="form-group">
                <label>Kota / Kabupaten</label>
                <input type="text" id="pKota" placeholder="Contoh: Jakarta Selatan" required>
            </div>

            <button type="submit" class="btn-save">Simpan Perubahan</button>
        </form>

        <a href="index.html" class="btn-back">← Kembali ke Beranda</a>
    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyAkU02LCtMx-KAhsjLPmSsR0ZEs-jVlyHI",
            authDomain: "the-last-call-film.firebaseapp.com",
            projectId: "the-last-call-film",
            storageBucket: "the-last-call-film.firebasestorage.app",
            messagingSenderId: "665352445108",
            appId: "1:665352445108:web:3ae79656e3dfcb22254be1"
        };
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();
        const auth = firebase.auth();

        let currentUser = null;

        // CEK LOGIN
        auth.onAuthStateChanged(async (user) => {
            if (user) {
                currentUser = user;
                document.getElementById('pEmail').value = user.email;

                // Ambil data profil dari Firestore
                const doc = await db.collection("members").doc(user.uid).get();
                if (doc.exists) {
                    const data = doc.data();
                    document.getElementById('pNama').value = data.name || user.displayName || '';
                    document.getElementById('pNoHp').value = data.phone || '';
                    document.getElementById('pKota').value = data.city || '';
                } else if (user.displayName) {
                    document.getElementById('pNama').value = user.displayName;
                }
            } else {
                alert("Silakan login terlebih dahulu.");
                window.location.href = "index.html";
            }
        });

        // SIMPAN PROFIL KEMBALI KE FIRESTORE
        async function simpanProfil(e) {
            e.preventDefault();
            if (!currentUser) return;

            const name = document.getElementById('pNama').value.trim();
            const phone = document.getElementById('pNoHp').value.trim();
            const city = document.getElementById('pKota').value.trim();

            try {
                await db.collection("members").doc(currentUser.uid).set({
                    uid: currentUser.uid,
                    email: currentUser.email,
                    name: name,
                    phone: phone,
                    city: city,
                    updatedAt: firebase.firestore.FieldValue.serverTimestamp()
                }, { merge: true });

                alert("Profil berhasil diperbarui!");
            } catch (err) {
                console.error(err);
                alert("Gagal menyimpan profil.");
            }
        }
    </script>
</body>
</html>
